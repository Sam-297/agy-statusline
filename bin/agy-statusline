#!/usr/bin/env node
import module from 'node:module';

module.enableCompileCache?.(); // Node >= 22.1: caches compiled code between runs

const args = process.argv.slice(2);
if (args.length === 0 && !process.stdin.isTTY) {
  // Published packages ship a one-file bundle of the render path (scripts/build.mjs).
  const { runRender } = await import('../src/core/run.bundle.js').catch(
    () => import('../src/core/run.js')
  );
  await runRender();
  process.exit(0);
} else {
  const { runCli } = await import('../src/cli/index.js');
  process.exit(await runCli(args));
}
